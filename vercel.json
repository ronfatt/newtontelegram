{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "static/images/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/events/stream",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/trigger/morning",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/trigger/afternoon",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/trigger/evening",
      "schedule": "0 12 * * *"
    }
  ]
}
